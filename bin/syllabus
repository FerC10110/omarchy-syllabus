#!/usr/bin/env python3
"""Entry point for Syllabus. The code lives in lib/syllabus next to this folder."""
import os
import sys

# The shell reloads the plugin when a file in its folder changes, so Python must
# not leave bytecode caches behind in it.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from syllabus.cli import main  # noqa: E402

sys.exit(main())
